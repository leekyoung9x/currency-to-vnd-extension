{
  "manifest_version": 3,
  "name": "Currency to VND Converter",
  "version": "1.0.0",
  "description": "Tự động quét trang web, nhận diện tiền tệ nước ngoài (USD, EUR, GBP, JPY, …) và quy đổi sang Việt Nam Đồng (VND).",
  "permissions": ["storage", "scripting", "activeTab", "alarms"],
  "host_permissions": ["<all_urls>", "https://open.er-api.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Currency to VND",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/currency.js", "shared/rates.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["shared/currency.js", "shared/rates.js", "verify/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
